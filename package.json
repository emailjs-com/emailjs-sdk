{
  "name": "@emailjs/browser",
  "version": "4.4.1",
  "description": "Official EmailJS SDK for browsers",
  "private": false,
  "author": "EmailJS",
  "contributors": [
    "Sergey Khomushin <sergey@emailjs.com> (https://www.emailjs.com)"
  ],
  "homepage": "https://www.emailjs.com",
  "license": "BSD-3-Clause",
  "type": "module",
  "main": "cjs/index.js",
  "types": "esm/index.d.ts",
  "module": "esm/index.js",
  "exports": {
    ".": {
      "types": "./esm/index.d.ts",
      "import": "./esm/index.js",
      "require": "./cjs/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emailjs-com/emailjs-sdk.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "scripts": {
    "_clean": "rm -rf esm && rm -rf cjs && rm -rf dist",
    "_set-version": "./set-version.sh $npm_package_version",
    "_set-type:cjs": "./set-type.sh cjs commonjs",
    "_set-type:esm": "./set-type.sh esm module",
    "_build:esm": "tsc --declaration --project ./tsconfig.build.json && npm run _set-version esm && npm run _set-type:esm",
    "_build:cjs": "tsc --target ES2019 --module CommonJS --moduleResolution Bundler --outDir cjs --project ./tsconfig.build.json && npm run _set-version cjs && npm run _set-type:cjs",
    "_build:bundle": "rollup -c",
    "_build:lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "build": "npm run _clean && npm run _build:lint && npm run _build:esm && npm run _build:cjs && npm run _build:bundle",
    "test": "jest --coverage --no-cache",
    "lint": "tsc --noEmit && eslint src"
  },
  "keywords": [
    "js email",
    "es6 email",
    "ts email",
    "javascript email",
    "typescript email",
    "emailjs",
    "email templates",
    "send email",
    "send email from js",
    "emailjs-com"
  ],
  "devDependencies": {
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@happy-dom/jest-environment": "^16.6.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-terser": "^0.4.4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.4",
    "core-js": "^3.50.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-compat": "^7.0.2",
    "jest": "^29.7.0",
    "prettier": "^3.9.9",
    "rollup": "^4.30.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "prettier": {
    "trailingComma": "all",
    "singleQuote": true,
    "printWidth": 100
  },
  "browserslist": [
    "> 0.25%",
    "not dead"
  ]
}
